# 开发环境走 Vite 代理（/api -> http://localhost:3030），留空即可
# 若改为直连后端，可设为 http://localhost:3030（需后端 CORS 已开）
VITE_API_BASE_URL=

# 生产（CVM 子路径）：服务层路径已含 /api，这里只写站点前缀
# 最终请求：/smart-station/api/...
# VITE_API_BASE_URL=/smart-station

# 可选：覆盖 Vite base（默认 production 为 /smart-station/）
# VITE_BASE=/smart-station/

# Kiosk / Scan 端所在驿站 ID（无登录端专用；单租户可留空）
VITE_KIOSK_STATION_ID=
