# =====================================================
# 通用
# =====================================================
node_modules/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo

# 环境变量（所有 .env 文件都不提交，只用 .env.example 作为模板）
.env
.env.local
.env.development
.env.production
.env.*
!.env.example

# 本地临时备份
_local_env_backup/

# 锁文件（如需提交请删除对应行）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# 其他临时文件
*.local
.cache/
.temp/
.tmp/
cloudbaserc.json

# 测试覆盖率
coverage/
*.lcov

# 测试结果
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# 工作记忆（可能包含敏感信息）
.workbuddy/memory/

# =====================================================
# PC 前端 (frontend) - React + Vite
# =====================================================
frontend/build/
frontend/dist/
frontend/.vercel/
frontend/.eslintcache
frontend/.stylelintcache

# =====================================================
# 后端 (backend) - NestJS
# =====================================================
backend/dist/
backend/build/
backend/.eslintcache
backend/.tsbuildinfo
backend/.runtimeconfig.json
