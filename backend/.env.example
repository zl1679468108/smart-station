# ============================================
# Smart Station 后端环境变量模板
# 复制为 .env.development / .env.production 后填入实际值
# 注意：与 family-bookkeeping 项目共用同一 Supabase 数据库，密钥相同，仅表名前缀不同（ss_ vs jj_）
# ============================================

# ---- Supabase 数据库 ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 后端服务使用 service_role_key 绕过 RLS（不要用 anon key）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 服务配置 ----
PORT=3030
NODE_ENV=development
FRONTEND_URL=http://localhost:3031

# ---- CORS（逗号分隔，未设置时使用默认值） ----
# CORS_ORIGINS=http://localhost:3031,https://your-domain.com

# 短信通道：stub|console|real（默认 stub，仅写 ss_sms_logs）
SMS_PROVIDER=stub

# ---- 腾讯云 OCR（面单识别智能入库 P1）----
# 控制台 https://console.cloud.tencent.com/cam/capi 获取；建议用仅授 OCR 权限的子账号密钥
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_OCR_REGION=ap-guangzhou
# OCR 每月免费额度硬上限（腾讯云通用印刷体免费额度约 1000/月，默认设 950 留安全垫）；到达上限后端直接拒绝，不再调用腾讯云，杜绝按量付费
TENCENT_OCR_MONTHLY_LIMIT=950
# 剩余量低于该阈值时后端日志告警、响应带 warning（默认 50）
TENCENT_OCR_WARN_THRESHOLD=50
