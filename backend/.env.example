# ============================================
# Smart Station 后端环境变量模板
# 复制为 .env.development / .env.production 后填入实际值
# 注意：与 family-bookkeeping 项目共用同一 Supabase 数据库，密钥相同，仅表名前缀不同（ss_ vs jj_）
# ============================================

# ---- Supabase 数据库 ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 后端服务使用 service_role_key 绕过 RLS（不要用 anon key）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 服务配置 ----
PORT=3030
NODE_ENV=development
FRONTEND_URL=http://localhost:3031

# ---- CORS（逗号分隔，未设置时使用默认值） ----
# CORS_ORIGINS=http://localhost:3031,https://your-domain.com

# ---- 通知通道（免费路线，不接商用短信）----
# 通道角色：
#   console     开发日志（完整内容）
#   wecom       企业微信【群】机器人 = 共享公告，仅脱敏（尾号），永不发取件码/验证码
#   serverchan  环境变量 SendKey = 管理员个人旁路（完整内容，仅你微信）
# 客户一对一完整取件码：ss_notify_bindings + WxPusher 扫码关注（主通道）
# 示例：NOTIFY_CHANNELS=console,wecom,serverchan
NOTIFY_CHANNELS=console
# 企业微信群机器人 Webhook（群设置 → 群机器人 → 添加 → 复制 Webhook）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key
# 管理员个人 Server酱 SendKey（https://sct.ftqq.com/）— 非客户绑定
# SERVERCHAN_SENDKEY=SCTxxxxxxxx
# WxPusher 应用 appToken（https://wxpusher.zjiecode.com/ 创建应用）— 客户扫码绑定必填
# WXPUSHER_APP_TOKEN=AT_xxxxxxxx
# 是否在 /api/kiosk/send-code 响应中返回 devCode（默认非 production 为 true）
# NOTIFY_EXPOSE_DEV_CODE=true
# 兼容旧变量（未配置 NOTIFY_CHANNELS 时等价 console；real 不再发商用短信）
SMS_PROVIDER=stub

# ---- 腾讯云 OCR（面单识别智能入库 P1）----
# 控制台 https://console.cloud.tencent.com/cam/capi 获取；建议用仅授 OCR 权限的子账号密钥
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_OCR_REGION=ap-guangzhou
# OCR 每月免费额度硬上限（腾讯云通用印刷体免费额度约 1000/月，默认设 950 留安全垫）；到达上限后端直接拒绝，不再调用腾讯云，杜绝按量付费
TENCENT_OCR_MONTHLY_LIMIT=950
# 剩余量低于该阈值时后端日志告警、响应带 warning（默认 50）
TENCENT_OCR_WARN_THRESHOLD=50
